{
  "name": "sam-uijeongbu-db",
  "version": "1.3.0",
  "description": "SAM 의정부 DB 스키마(Flyway) — 스키마의 유일한 정본",
  "private": true,
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "migrate": "node scripts/run-flyway.mjs migrate",
    "migrate:info": "node scripts/run-flyway.mjs info",
    "migrate:validate": "node scripts/run-flyway.mjs validate",
    "verify:security": "node scripts/run-check-security.mjs",
    "verify:supabase-like": "node scripts/verify-supabase-like.mjs",
    "test": "node --test \"scripts/*.test.mjs\"",
    "prepare": "git config core.hooksPath .githooks || true"
  }
}
